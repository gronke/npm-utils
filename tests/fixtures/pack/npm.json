{
  "npm": "12.1.0",
  "cases": {
    "allowlist": [
      "CHANGELOG.md",
      "LICENSE-MIT",
      "README.md",
      "bin/demo.js",
      "dist/index.js",
      "dist/nested/types.d.ts",
      "lib/a.js",
      "notes.md",
      "package.json"
    ],
    "bin-array-keyed-by-basename": [
      "package.json",
      "three/cli.js",
      "two/run.js"
    ],
    "bin-string-and-nested-manifest": [
      "cli.js",
      "package.json",
      "sub/lib/deep.js",
      "sub/package.json"
    ],
    "copying-and-dot-slash-entry-points": [
      "COPYING",
      "COPYING.txt",
      "LICENCE",
      "README~",
      "index.js",
      "license.md",
      "package.json",
      "readme.markdown"
    ],
    "default-rules-on-disk": [
      "build/keep.js",
      "index.js",
      "package.json",
      "sub/keep.js"
    ],
    "directories-bin": [
      "bin/cli.js",
      "package.json"
    ],
    "empty-bin-object-keeps-directories-bin-unexpanded": [
      "package.json"
    ],
    "entry-points-beat-ignores": [
      "build/browser.js",
      "build/cli.js",
      "build/index.js",
      "build/other.js",
      "index.js",
      "package.json"
    ],
    "extension-and-lockfiles": [
      "index.js",
      "package.json",
      "sub/yarn.lock"
    ],
    "files-are-case-sensitive": [
      "package.json",
      "src/c.js"
    ],
    "files-directory-forms": [
      "dist/c.js",
      "dist/sub/d.js",
      "lib/a.js",
      "package.json",
      "src/b.js",
      "vendor/v.js"
    ],
    "files-globstar-and-braces": [
      "a.js",
      "lib/b.js",
      "lib/types.d.ts",
      "package.json"
    ],
    "files-later-inclusion-wins": [
      "foo.js",
      "index.js",
      "package.json"
    ],
    "files-later-negation-wins": [
      "index.js",
      "package.json"
    ],
    "files-star-is-root-level": [
      "a.js",
      "package.json"
    ],
    "gitignore-under-npmignore-is-not-read": [
      "index.js",
      "package.json"
    ],
    "ignore-files-and-extglobs": [
      "LICENCE",
      "Readme",
      "build/index.js",
      "build/out.js",
      "docs/keep.md",
      "index.js",
      "keep.log",
      "lib/x.js",
      "logs/keep/y.log",
      "package.json",
      "readme.md~",
      "sub/x.js"
    ],
    "nested-ignores-under-files": [
      "lib/a.js",
      "lib/sub/b.js",
      "package.json"
    ],
    "patched-dependencies": [
      "index.js",
      "package.json",
      "patches/sub/z.patch",
      "patches/y.patch"
    ],
    "root-gitignore-fallback": [
      "index.js",
      "lib/a.js",
      "package.json"
    ],
    "silenced-ignore-files-are-not-read": [
      "dist/index.js",
      "package.json",
      "sub/a.js"
    ]
  }
}
